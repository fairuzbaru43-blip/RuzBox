# Supabase project settings (browser-safe publishable key recommended)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for older Supabase projects; prefer the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase secret key is preferred; the legacy service-role key is also accepted.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TeraBox Open Platform credentials. Apply for these from TeraBox first.
TERABOX_CLIENT_ID=
NEXT_PUBLIC_TERABOX_CLIENT_ID=
TERABOX_CLIENT_SECRET=
TERABOX_PRIVATE_SECRET=

# Exact application namespace assigned by TeraBox. Example shape only:
# /Dari: Aplikasi Lain/RuzBox-<assigned-id>/
TERABOX_ROOT_PATH=

# Base64-encoded 32-byte AES key for encrypting TeraBox tokens in Postgres.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Optional: separately deploy transfer-service/ for streaming uploads > 4 MiB.
NEXT_PUBLIC_TRANSFER_SERVICE_URL=
TRANSFER_SERVICE_SECRET=
